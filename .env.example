# ============================================================
# Varr-Bot configuration
# Copy this file to .env and fill in your own values.
# Never commit .env.
# ============================================================

# Identitas bot
BOT_NAME=Varr-Bot
# Beberapa prefix dipisahkan koma, misalnya: .,!,/
PREFIX=.
LOG_LEVEL=info

# Owner dalam format nomor internasional tanpa "+" atau spasi.
# Pisahkan beberapa nomor dengan koma.
OWNER_NUMBERS=

# Mode awal: public | private | self
# Nilai ini bisa diubah saat runtime lewat .mode (owner).
MODE=public

# Bahasa default: id | en
DEFAULT_LANG=id

# Login: qr | pairing
# Kosongkan untuk otomatis: pairing jika PAIRING_NUMBER diisi, selain itu qr.
LOGIN_METHOD=
# Nomor WhatsApp untuk pairing code, dengan kode negara. Contoh: 6281234567890
PAIRING_NUMBER=

# Direktori runtime (relatif terhadap root project atau absolut)
DATA_DIR=./data
AUTH_DIR=./auth_info_baileys

# Zona waktu untuk log dan nama file backup (Docker)
TZ=Asia/Jakarta

# Database
# Kosongkan untuk memakai SQLite (data/varr.db).
# DATABASE_URL=sqlite:./data/varr.db
# MySQL panel Pterodactyl baru didukung pada fase scale:
# DATABASE_URL=mysql://user:password@host:3306/varr_bot
DATABASE_URL=

# Perilaku command
# Timeout default untuk command biasa. Command downloader memakai timeout
# sendiri yang lebih panjang (lihat DOWNLOAD_TIMEOUT_MS).
COMMAND_TIMEOUT_MS=30000
COMMAND_COOLDOWN=3
# Maksimum pesan menunggu per chat sebelum pesan baru dilewati.
QUEUE_MAX_PENDING=50
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Media & downloader (Phase 2)
# Batas ukuran untuk media yang dikirim/diterima (sticker, toimg).
MEDIA_MAX_MB=16
# Binary yt-dlp. Isi path absolut bila tidak ada di PATH.
YTDLP_PATH=yt-dlp
# Pasang otomatis yt-dlp dari rilis resmi GitHub bila tidak ditemukan.
# Nonaktif secara default. Hanya rilis resmi + checksum SHA-256 yang dipakai.
YTDLP_AUTO_INSTALL=false
# Folder binary lokal. Bila berisi yt-dlp, binary ini dipakai sebelum PATH.
BIN_DIR=./data/bin
# Binary FFmpeg. Isi path absolut bila tidak ada di PATH.
FFMPEG_PATH=ffmpeg
# Opsional: file cookies Netscape untuk video yang butuh login/usia.
YTDLP_COOKIES_FILE=
# Batas ukuran file unduhan. Naikkan (mis. 64) bila ingin .ytmp4 1080p.
DOWNLOAD_MAX_MB=16
DOWNLOAD_MAX_DURATION_SEC=900
# Batas proses unduh (probe + download). Command downloader memakai timeout
# internal 660 detik agar tidak dipotong COMMAND_TIMEOUT_MS.
DOWNLOAD_TIMEOUT_MS=120000
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_QUEUE_MAX=10
# Folder temporary untuk unduhan; dibersihkan otomatis setelah dipakai.
TMP_DIR=./data/tmp

# Backup database
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# AI (Phase 3) — isi provider yang tersedia
# Gunakan *_API_KEYS untuk key pool (dipisahkan koma). Key lama *_API_KEY
# tetap didukung, tapi *_API_KEYS menang bila keduanya diisi.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model default untuk provider utama (gemini). Bila kosong, memakai AI_PRIMARY_MODEL.
AI_DEFAULT_MODEL=
# Timeout per request AI dalam milidetik.
AI_TIMEOUT_MS=60000
# Kuota harian per pengguna/chat (0 = tanpa batas).
AI_DAILY_QUOTA_PER_USER=0

# Urutan provider/model. Pisahkan fallback dengan koma.
AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-4-hydrogen
AI_FALLBACKS=gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
